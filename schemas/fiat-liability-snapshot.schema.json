{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMR Fiat Liability Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotId",
    "asOf",
    "convertibleAmrFiatMxn",
    "restrictedSettlementMxn"
  ],
  "properties": {
    "snapshotId": {
      "type": "string"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "convertibleAmrFiatMxn": {
      "type": "number",
      "minimum": 0
    },
    "restrictedSettlementMxn": {
      "type": "number",
      "minimum": 0
    },
    "prudentialBufferMxn": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "sourceLedgerHash": {
      "type": "string"
    }
  }
}
