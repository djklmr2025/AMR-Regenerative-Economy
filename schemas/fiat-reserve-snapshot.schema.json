{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMR Fiat Reserve Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotId",
    "asOf",
    "currency",
    "eligibleLiquidMxn",
    "auditStatus",
    "evidence"
  ],
  "properties": {
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "const": "MXN"
    },
    "eligibleLiquidMxn": {
      "type": "number",
      "minimum": 0
    },
    "encumberedMxn": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "auditStatus": {
      "enum": [
        "PENDING",
        "VERIFIED",
        "DISPUTED",
        "REJECTED"
      ]
    },
    "auditorId": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "uri"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "hash": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "bank_statement",
              "payment_processor_settlement",
              "custody_attestation",
              "ledger_reconciliation",
              "other"
            ]
          }
        }
      }
    }
  }
}
