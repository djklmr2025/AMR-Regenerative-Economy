{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Proof of Reserves",
  "description": "Schema for auditing and proving physical and digital reserves",
  "type": "object",
  "properties": {
    "reserveId": {
      "type": "string"
    },
    "assetType": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "custodian": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "valuation": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "evidenceUri": {
      "type": "string",
      "format": "uri"
    },
    "auditStatus": {
      "type": "string",
      "enum": ["PENDING", "VERIFIED", "DISPUTED", "REJECTED"]
    }
  },
  "required": ["reserveId", "assetType", "quantity", "custodian", "jurisdiction", "date", "valuation", "evidenceUri", "auditStatus"]
}
